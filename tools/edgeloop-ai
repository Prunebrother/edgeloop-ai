#!/usr/bin/env python3
"""AGPL-3.0-only. Desktop lifecycle for the dedicated local EdgeLoop AI stack."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time
from urllib.request import build_opener, ProxyHandler

UNITS=['edgeloop-ai-ollama.service','edgeloop-ai-observer.service','edgeloop-ai-web.service']
TARGET='edgeloop-ai.target'
URL='http://127.0.0.1:8770/'
HTTP=build_opener(ProxyHandler({}))

def systemctl(*args,check=True):
    return subprocess.run(['systemctl','--user',*args],check=check,capture_output=True,text=True)

def notify(message,failed=False):
    try:subprocess.run(['notify-send','-a','EdgeLoop AI','-u','critical' if failed else 'normal','EdgeLoop AI',message],timeout=5,check=False)
    except (OSError,subprocess.TimeoutExpired):pass

def healthy(url,kind):
    try:
        with HTTP.open(url,timeout=2) as response:
            if kind=='web':return b'EdgeLoop' in response.read(4096)
            data=json.load(response)
            return isinstance(data.get('models'),list) if kind=='ollama' else data.get('ok') is True and data.get('read_only') is True
    except (OSError,ValueError):return False

def wait_ready():
    deadline=time.monotonic()+60
    checks=[('http://127.0.0.1:11435/api/tags','ollama'),('http://127.0.0.1:8768/health','observer'),(URL,'web')]
    while time.monotonic()<deadline:
        if any(systemctl('is-failed','--quiet',unit,check=False).returncode==0 for unit in UNITS):
            raise RuntimeError('A service failed. Inspect journalctl --user -u edgeloop-ai-ollama -u edgeloop-ai-observer -u edgeloop-ai-web.')
        if all(healthy(url,kind) for url,kind in checks):return
        time.sleep(.5)
    raise RuntimeError('Startup timed out. Run edgeloop-ai status and inspect the service journal. No occupied ports were killed.')

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['start','stop','status'])
    parser.add_argument('--no-browser',action='store_true',help='Start services without opening the browser')
    args=parser.parse_args()
    runtime=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))
    with (runtime/'edgeloop-ai-control.lock').open('w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if args.action=='status':
            result=systemctl('status',TARGET,*UNITS,'--no-pager',check=False)
            print(result.stdout or result.stderr)
            return result.returncode
        if args.action=='stop':
            systemctl('stop',TARGET,*reversed(UNITS))
            print('EdgeLoop AI stopped. Web server, observer and dedicated Ollama are off.')
            notify('Stopped. Web server, AI observer and Ollama are off. The browser tab can be closed.')
            return 0
        systemctl('reset-failed',*UNITS,check=False)
        systemctl('start',TARGET)
        wait_ready()
        print('EdgeLoop AI ready: '+URL)
        if not args.no_browser:
            subprocess.Popen(['xdg-open',URL],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        notify('Ready. Use Stop EdgeLoop AI to shut down the stack. End any hardware session in EdgeLoop first.')
        return 0

if __name__=='__main__':
    try:sys.exit(main())
    except (OSError,RuntimeError,subprocess.CalledProcessError) as exc:
        message=exc.stderr.strip() if isinstance(exc,subprocess.CalledProcessError) else str(exc)
        print('EdgeLoop AI: '+message,file=sys.stderr);notify(message,True);sys.exit(1)
