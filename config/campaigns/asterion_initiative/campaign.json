        {
          "id": "log",
          "type": "puzzle_solved",
          "label": "Puzzle 1: The access log",
          "puzzle": {
            "title": "The access log",
            "clues": [
              "02:14 Door B-7 opened. Badge ASR-0413.",
              "02:16 Server room opened. Badge ASR-0413.",
              "02:31 Server room closed. Badge ASR-0413.",
              "Badge ASR-0413 is registered to you. Badges are issued only by Asterion Security, internally.",
              "Camera 4: your own badge stayed in your locker all night."
            ],
            "question": "What do the logs say about the badge the intruder used?",
            "options": [
              {
                "id": "carried",
                "label": "Your real badge, carried by you"
              },
              {
                "id": "internal",
                "label": "A copy of an internally issued Asterion credential"
              },
              {
                "id": "outside",
                "label": "A forged badge made outside Asterion"
              },
              {
                "id": "none",
                "label": "No badge was used"
              }
            ],
            "answer": "internal",
            "hint": "Your badge never left the locker, so the one at the doors was a copy. And who issues Asterion badges?"
          }
        },
        {
          "id": "money",
          "type": "puzzle_solved",
          "label": "Puzzle 2: Follow the money",
          "puzzle": {
            "title": "Follow the money",
